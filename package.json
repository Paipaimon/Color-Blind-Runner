{
  "name": "color-blind-runner",
  "version": "1.0.0",
  "description": "多人协作生存游戏 - 颜色可见性规则",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:node": "node scripts/build.mjs",
    "start:server": "node dist/server/index.js",
    "dev:server": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:node": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
